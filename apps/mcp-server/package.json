{
  "name": "@factstack/mcp-server",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "FACTS Model Context Protocol server. Exposes analyzer artifacts as MCP resources + tools for AI-agent consumption. stdio transport in v0.2; SSE transport in v0.5.",
  "type": "module",
  "bin": {
    "factstack-mcp": "./dist/server.js"
  },
  "main": "./src/server.ts",
  "homepage": "https://factstack.pages.dev",
  "engines": {
    "node": ">=24.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "assemble": "node scripts/assemble-publish.mjs",
    "smoke:bundle": "node scripts/smoke-bundle.mjs --pack",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/core": "workspace:*",
    "@factstack/emit": "workspace:*",
    "@factstack/extractors": "workspace:*",
    "@factstack/factspack": "workspace:*",
    "@factstack/fs-node": "workspace:*",
    "@factstack/scanners": "workspace:*",
    "@factstack/spec": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
