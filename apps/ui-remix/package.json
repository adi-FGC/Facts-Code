{
  "name": "@factstack/ui-remix",
  "version": "0.0.0",
  "private": true,
  "description": "Primary WebUI for FACTS. Remix 3 (beta) utility modules + React 19 + React Router v7, served by Vite. Two build targets: dev server (live re-analyze) and static mode (self-contained SPA for `factstack export`, Netlify deploy, and future VS Code webview hosting).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && node scripts/inject-data.mjs",
    "build:static": "vite build --mode static && node scripts/inject-data.mjs",
    "start": "vite preview --port 3000",
    "test": "echo 'no tests yet' && exit 0",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factstack/spec": "workspace:*",
    "@factstack/ui-theme": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "framer-motion": "^11.11.1",
    "lucide-react": "^0.451.0",
    "react": "^19.0.0",
    "react-arborist": "^3.4.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.14.1",
    "remix": "3.0.0-beta.0",
    "shiki": "^1.22.0",
    "tiktoken": "^1.0.17"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "lightningcss": "^1.27.0",
    "tailwindcss": "^4.0.0-beta.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.8"
  }
}
