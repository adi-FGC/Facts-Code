{
  "name": "@factstack/ui-remix",
  "version": "0.0.0",
  "private": true,
  "description": "Primary WebUI for FACTS. Built on Remix v3 (beta) — its own VDOM runtime, no React. Vite + JSX via @remix-run/ui's automatic runtime. Two build targets: dev server (live re-analyze) and static (Netlify deploy, `factstack export`, VS Code webview).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && node scripts/inject-data.mjs",
    "build:static": "vite build --mode static && node scripts/inject-data.mjs",
    "start": "vite preview --port 3000",
    "test": "echo 'no tests yet' && exit 0",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factstack/spec": "workspace:*",
    "@factstack/ui-theme": "workspace:*",
    "remix": "3.0.0-beta.0"
  },
  "devDependencies": {
    "@remix-run/ui": "0.1.1",
    "lightningcss": "^1.27.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.8"
  }
}
