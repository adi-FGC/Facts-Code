# Cloudflare Pages cache + security headers. Mirrors netlify.toml so the two
# hosts behave identically.
#
# Cloudflare applies EVERY matching rule, in file order, and APPENDS a header
# an earlier rule already set — it does not replace it. A later block that
# needs a different value for a header `/*` sets must first detach it with
# `! Header-Name`. scripts/lib/cf-headers.mjs models this and
# check-bundle-size.mjs fails the build when a path would get a header twice.
#
# HTML (incl. the inline-baked dataset in index.html) must revalidate every
# load so a fresh `factstack analyze` + redeploy ships instantly. Hashed assets
# under /assets/ are content-addressed (index-<hash>.js) so they're immutable.
# Cloudflare serves clean URLs (`/`, `/review`), which `/*.html` never matches:
# generate-discovery.mjs appends one rule per SPA route to dist/_headers.
/*.html
  # must-revalidate keeps a redeploy instant. No stale-while-revalidate: next
  # to must-revalidate it never applies, and a stale page would ask for the
  # previous deploy's /assets/* hashes (lib/cf-headers.mjs HTML_CACHE_CONTROL).
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Self-hosted woff2 (src/styles/fonts.css). Content never changes under a
# given name — replacing a face means a new filename, not new bytes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
# Agent-discovery + data endpoints (see netlify.toml for rationale).
/factstack.pack
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/site.webmanifest
  Content-Type: application/manifest+json
/data/*
  Cache-Control: public, max-age=0, must-revalidate
# The dataset sections index.html preloads when a build splits them
# (performance#5; `inject-data.mjs --split-sections`, off by default). Content-
# addressed (<name>.<sha256-12>.json, scripts/lib/dataset-sections.mjs), so a name never
# gets new bytes: immutable, like /assets/*. A page still open across a
# redeploy then reads its own sections instead of a newer deploy's. The detach
# drops the /data/* value above, which Cloudflare would otherwise append.
/data/sections/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # CSP scoped to exactly what this static SPA loads. script-src pins the one
  # inline boot script (the no-flash theme init in index.html) by SHA-256 — no
  # 'unsafe-inline' — so it survives strict CSP; the hash is re-verified at build
  # time by scripts/check-bundle-size.mjs (fails the build if the script drifts).
  # The baked dataset is <script type="application/json"> (data, not executed).
  # connect-src allows the OSV CVE API + GitHub (the in-browser GitHub-repo
  # scanner fetches the tree/blobs from api.github.com + raw.githubusercontent.com;
  # the scan runs in a Web Worker whose fetches are governed by THIS page CSP, so
  # worker-src alone does not cover them). Fonts are self-hosted from /fonts
  # (v0.3.13), so no third-party font or style origin appears here.
  # SEC-3: style-src carries NO 'unsafe-inline'. The css() runtime injects rules
  # via constructable adoptedStyleSheets (CSSOM — CSP-exempt), static CSS ships as
  # <link> assets, and every inline style= attribute was converted to a css()
  # class or SVG presentation attribute. check-bundle-size.mjs fails the build if
  # 'unsafe-inline' ever creeps back into style-src.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'sha256-mep93d+TYbqkTXigp7/se25JNnDPP4lUmN1PshDxS+o='; worker-src 'self' blob:; connect-src 'self' https://api.osv.dev https://api.github.com https://raw.githubusercontent.com; manifest-src 'self'

# Scoped CSP for the MCP Google sign-in page ONLY — it loads the Firebase SDK
# from gstatic + runs the Google popup + POSTs the token to the local loopback.
# Kept separate so the main app CSP above stays strict. Must stay byte-equal to
# the /mcp-auth and /mcp-auth.html blocks in netlify.toml — check-bundle-size.mjs
# enforces that every /mcp-auth* block carries the identical scoped policy.
#
# TWO keys on purpose: Cloudflare Pages serves clean URLs — it 308-redirects
# `/mcp-auth.html` → `/mcp-auth` and applies headers to the SERVED path, so the
# `.html` rule alone never matches on CF and the page falls back to the strict
# main CSP (Firebase SDK from gstatic gets blocked).
#
# These blocks govern CLOUDFLARE only. Netlify applies this file too, but under
# netlify.toml, and for the same header a later rule replaces an earlier one —
# so netlify.toml's `/*` CSP overrides both blocks here. netlify.toml therefore
# keys /mcp-auth and /mcp-auth.html itself, below its `/*`
# (scripts/lib/netlify-headers.mjs models this; seen live 2026-09-24).
#
# `! Content-Security-Policy` first: `/*` above also matches these paths, and
# without the detach Cloudflare sends BOTH policies — the browser enforces the
# strict one too, blocks the gstatic import and the page never signs in (seen
# live 2026-09-24). These blocks must stay BELOW `/*` for the detach to apply.
/mcp-auth.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.googleapis.com http://127.0.0.1:* http://localhost:*; frame-src https://facts-stack.firebaseapp.com https://accounts.google.com
/mcp-auth
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.googleapis.com http://127.0.0.1:* http://localhost:*; frame-src https://facts-stack.firebaseapp.com https://accounts.google.com
