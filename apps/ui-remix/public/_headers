# Cloudflare Pages cache + security headers. Mirrors netlify.toml so the two
# hosts behave identically.
#
# HTML (incl. the inline-baked dataset in index.html) must revalidate every
# load so a fresh `factstack analyze` + redeploy ships instantly. Hashed assets
# under /assets/ are content-addressed (index-<hash>.js) so they're immutable.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # CSP scoped to exactly what this static SPA loads. script-src pins the one
  # inline boot script (the no-flash theme init in index.html) by SHA-256 — no
  # 'unsafe-inline' — so it survives strict CSP; the hash is re-verified at build
  # time by scripts/check-bundle-size.mjs (fails the build if the script drifts).
  # The baked dataset is <script type="application/json"> (data, not executed).
  # connect-src allows the OSV CVE API + GitHub (the in-browser GitHub-repo
  # scanner fetches the tree/blobs from api.github.com + raw.githubusercontent.com;
  # the scan runs in a Web Worker whose fetches are governed by THIS page CSP, so
  # worker-src alone does not cover them). style/font-src allow Google Fonts.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-mep93d+TYbqkTXigp7/se25JNnDPP4lUmN1PshDxS+o='; worker-src 'self' blob:; connect-src 'self' https://api.osv.dev https://api.github.com https://raw.githubusercontent.com; manifest-src 'self'
