{
  "name": "@factstack/cli",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "FACTS CLI — `factstack` binary (Node ≥ 24.3). Composes @factstack/core via @factstack/fs-node; `ui` / `export` / `quick` serve the hardened legacy prototype built by scripts/sync-ui.mjs (inline CSS, system fonts, vendored @babel/parser, strict CSP).",
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "bin": {
    "factstack": "./dist/cli.js"
  },
  "main": "./src/cli.ts",
  "homepage": "https://factstack.pages.dev",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run sync:ui && tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "pack:dry-run": "node scripts/bundle.mjs --pack-dry-run",
    "dev": "tsx src/cli.ts",
    "sync:ui": "node scripts/sync-ui.mjs",
    "test": "vitest run",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/core": "workspace:*",
    "@factstack/emit": "workspace:*",
    "@factstack/extractors": "workspace:*",
    "@factstack/fs-node": "workspace:*",
    "@factstack/scanners": "workspace:*",
    "@factstack/skills": "workspace:*",
    "@factstack/spec": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "kleur": "^4.1.5",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
