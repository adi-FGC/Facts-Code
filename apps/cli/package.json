{
  "name": "@factstack/cli",
  "version": "0.0.0",
  "private": true,
  "description": "FACTS CLI — `factstack` binary. Node 20+ & Deno 2+ compatible. Primary v0.1 surface. Composes @factstack/core via @factstack/fs-node and spawns @factstack/ui-remix server.",
  "type": "module",
  "bin": {
    "factstack": "./dist/cli.js"
  },
  "main": "./src/cli.ts",
  "scripts": {
    "build": "pnpm run sync:ui && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "sync:ui": "node scripts/sync-ui.mjs",
    "test": "echo 'no tests yet' && exit 0",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factstack/core": "workspace:*",
    "@factstack/emit": "workspace:*",
    "@factstack/extractors": "workspace:*",
    "@factstack/fs-node": "workspace:*",
    "@factstack/spec": "workspace:*",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
