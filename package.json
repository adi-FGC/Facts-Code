{
  "name": "factstack",
  "version": "0.0.0",
  "private": true,
  "description": "FACTS — AI Coding Tracker Stack. A cross-platform static code analyzer emitting AI-agent-readable and CXO-readable artifacts from one analysis pass.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "prettier": "^3.3.3",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0"
  }
}
