{
  "name": "factstack",
  "version": "0.0.0",
  "private": true,
  "description": "FACTS — AI Coding Tracker Stack. A cross-platform static code analyzer emitting AI-agent-readable and CXO-readable artifacts from one analysis pass.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm test:proto",
    "test:proto": "node prototype/scripts/smoke-scan.mjs && node prototype/scripts/smoke-scan-deep.mjs",
    "test:cov": "turbo run test:cov",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:boundaries": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:md": "prettier --write \"**/*.{md,json,yaml,yml}\"",
    "format:md:check": "prettier --check \"**/*.{md,json,yaml,yml}\"",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
