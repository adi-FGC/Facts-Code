{
  "name": "factstack",
  "version": "0.1.0",
  "private": true,
  "description": "FACTS — Fun AI Coding Tools. A cross-platform static code analyzer emitting AI-agent-readable and CXO-readable artifacts from one analysis pass.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm test:legacy-proto",
    "test:legacy-proto": "node legacy/prototype/scripts/smoke-scan.mjs && node legacy/prototype/scripts/smoke-scan-deep.mjs && node legacy/prototype/scripts/smoke-scan-github.mjs",
    "test:cov": "turbo run test:cov",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:boundaries": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:md": "prettier --write \"**/*.{md,json,yaml,yml}\"",
    "format:md:check": "prettier --check \"**/*.{md,json,yaml,yml}\"",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}