{
  "name": "factstack",
  "version": "0.1.0",
  "private": true,
  "description": "FACTS — Fun AI Coding Tools. A cross-platform static code analyzer emitting AI-agent-readable and CXO-readable artifacts from one analysis pass.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.3.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm test:root && pnpm test:legacy-proto",
    "test:legacy-proto": "node legacy/prototype/scripts/smoke-scan.mjs && node legacy/prototype/scripts/smoke-scan-deep.mjs && node legacy/prototype/scripts/smoke-scan-github.mjs",
    "test:cov": "turbo run test:cov",
    "test:root": "vitest run --dir test",
    "bench": "node apps/cli/node_modules/tsx/dist/cli.mjs apps/cli/src/cli.ts bench",
    "bench:check": "node apps/cli/node_modules/tsx/dist/cli.mjs apps/cli/src/cli.ts bench --check",
    "bench:update": "node apps/cli/node_modules/tsx/dist/cli.mjs apps/cli/src/cli.ts bench --update",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:boundaries": "eslint . && vitest run test/boundaries.test.mjs",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
