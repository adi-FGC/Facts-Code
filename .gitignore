node_modules/
dist/
build/
.turbo/
.remix/
.cache/
coverage/
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db

# FACTS output (should be per-project, committed here because this repo IS FACTS)
# .facts/

# Local env
.env
.env.local
.env.*.local

# Test artifacts
playwright-report/
test-results/
examples/__screenshots__/*-actual.png
examples/__screenshots__/*-diff.png

# FACTS analysis artifacts
.facts/
.gstack/

# Agent / editor tooling — skill definitions installed into the project
# dir by the design-skill plugins. Per-machine, not FACTS source.
.agents/

# Netlify CLI per-app link state — appears under any nested workspace
# that runs `netlify deploy --filter <pkg>`. The root `.netlify/state.json`
# IS tracked (links the repo to the factstack-demo site); only the
# per-package shadow copies need ignoring.
apps/*/.netlify/
packages/*/.netlify/

# TypeScript incremental build cache — per-machine, no value in git
*.tsbuildinfo

# Tool / MCP scratch artifacts — Playwright MCP screenshot + log dumps,
# ad-hoc HTML files generated by IDE-side previews. Local-only, never
# shipped to production. Anchored with leading / so the patterns match
# only at the repo root (sub-app HTML files like apps/ui-remix/index.html
# stay tracked).
.playwright-mcp/
/design.html
/DAGswimlanes.html
/facts_dag.html

# Ad-hoc preview / screenshot scratch — when verifying a docs/*.html
# render we drop a throwaway Playwright script + its PNGs next to the
# package whose node_modules resolves @playwright/test. These are
# verification scratch, never committed. UN-anchored (no leading /) so
# they're ignored at any depth, including apps/*/ and packages/*/.
.shot.mjs
.shot-*.png

# Agent scratch — ad-hoc probe scripts dropped next to a package while
# reverse-engineering a format. Numbered, throwaway, never source.
packages/*/probe*.mjs

# Point-in-time commit-gate audit artifacts (ELI5 new-CTO audits). Generated
# fresh per commit as a review aid; not source, kept local only.
docs/cto-eli5-audit-*.html

# Generated adversarial-review reports (multi-agent review output). Same
# category as the ELI5 audits above: a per-pass review aid, not source.
docs/adversarial-review-*.md

# Local MCP client config for this repo (per-machine install state written
# by `factstack install`/uninstall). Not source.
/.mcp.json

# Local Firebase client-config file (public web keys, kept per-machine). The
# same public config is embedded where it's actually used (mcp-server/auth.ts,
# ui-remix/public/mcp-auth.js); this loose copy is never committed.
/fb.mjs

# Scratch scrub-logic experiments — the real, shipped scrubber lives in
# apps/ui-remix/scripts/inject-data.mjs. These numbered probes are throwaway.
apps/ui-remix/scripts/_scrub-test*.mjs

# Generated adversarial-review reports in HTML (same category as the .md
# reports and the ELI5 audits above — a per-pass review aid, not source).
docs/*adversarial-review*.html
