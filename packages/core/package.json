{
  "name": "@factstack/core",
  "version": "0.0.0",
  "private": true,
  "description": "Analyzer orchestration. Composes walker + parsers + extractors + graph + scanners into a single analysis run. **ISOMORPHIC — must not import Node built-ins.** Consumed by every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factstack/extractors": "workspace:*",
    "@factstack/graph": "workspace:*",
    "@factstack/parsers": "workspace:*",
    "@factstack/scanners": "workspace:*",
    "@factstack/spec": "workspace:*",
    "@factstack/walker": "workspace:*"
  },
  "devDependencies": {
    "@factstack/fs-memory": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
