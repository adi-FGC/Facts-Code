{
  "name": "@factstack/core",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Analyzer orchestration. Composes walker + parsers + extractors + graph + scanners into a single analysis run. **ISOMORPHIC — must not import Node built-ins.** Consumed by every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./md-fence": "./src/md-fence.ts",
    "./plain-text": "./src/plain-text.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/extractors": "workspace:*",
    "@factstack/factspack": "workspace:*",
    "@factstack/graph": "workspace:*",
    "@factstack/intent": "workspace:*",
    "@factstack/parsers": "workspace:*",
    "@factstack/scanners": "workspace:*",
    "@factstack/spec": "workspace:*",
    "@factstack/walker": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@factstack/fs-memory": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
