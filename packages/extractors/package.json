{
  "name": "@factstack/extractors",
  "version": "0.0.0",
  "private": true,
  "description": "Per-language symbol / route / component / import extractors. Pure — take AST nodes in, emit FileOutline out. Isomorphic.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.25.6",
    "@factstack/parsers": "workspace:*",
    "@factstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
