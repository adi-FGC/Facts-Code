{
  "name": "@factstack/walker",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Gitignore-aware filesystem walker. Takes a FactsFS interface (constraint C1) — no direct Node fs imports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/spec": "workspace:*",
    "ignore": "^7.0.11"
  },
  "devDependencies": {
    "@factstack/fs-memory": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
