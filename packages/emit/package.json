{
  "name": "@factstack/emit",
  "version": "0.0.0",
  "private": true,
  "description": "Serializers: agent.json, agent.jsonl, human.json, index.db via node:sqlite (Node 22+ built-in, zero native compile), static HTML export bundle. This is the only package allowed to use Node built-ins alongside core analysis.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factstack/core": "workspace:*",
    "@factstack/factspack": "workspace:*",
    "@factstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
