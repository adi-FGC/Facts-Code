{
  "name": "@factstack/emit",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Serializers: agent.json, agent.jsonl, human.json, index.db via node:sqlite (Node 22+ built-in, zero native compile), static HTML export bundle. This is the only package allowed to use Node built-ins alongside core analysis.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/core": "workspace:*",
    "@factstack/factspack": "workspace:*",
    "@factstack/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
