{
  "name": "@factstack/spec",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas + TS types for FACTS artifacts (agent.json, human.json), FactsFS interface, and MCP resource/tool sketch. Single source of truth — imported by every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./human": "./src/human.ts",
    "./diff": "./src/diff.ts",
    "./fs": "./src/fs.ts",
    "./mcp": "./src/mcp.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
