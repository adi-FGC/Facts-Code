{
  "name": "@factstack/spec",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Zod schemas + TS types for FACTS artifacts (agent.json, human.json), FactsFS interface, and MCP resource/tool sketch. Single source of truth — imported by every surface.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/zod.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./human": "./src/human.ts",
    "./diff": "./src/diff.ts",
    "./fs": "./src/fs.ts",
    "./mcp": "./src/mcp.ts",
    "./routes": "./src/routes.ts",
    "./review": "./src/review.ts",
    "./mcp-catalog": "./src/mcp-catalog.ts",
    "./review-severity": "./src/review-severity.ts",
    "./git": "./src/git.ts",
    "./zod": "./src/zod.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
