{
  "name": "@factstack/scanners",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Cross-cutting scanners: secrets, licenses, frameworks, TODOs, git history, bundle-size estimator, tiktoken token-cost estimator. Isomorphic; secrets always redacted before emission.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'no lint yet' && exit 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@factstack/extractors": "workspace:*",
    "@factstack/spec": "workspace:*",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
